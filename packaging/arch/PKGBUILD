# PnP Üretim Takipçisi — Garuda/Arch Linux package (Faz 3 / İş 12).
#
# This is the template `./gradlew :app:packageArch` fills in and builds with
# makepkg; it is not meant to be run by hand. The @…@ values come from the
# Gradle build: the version is the Gradle project version and nothing else, and
# the source is the self-contained archive `:app:packageLinuxArchive` made and
# `:app:verifyLinuxPackage` checked. Nothing is compiled here.

pkgname=pnp-tracker
pkgver=@PKGVER@
pkgrel=1
pkgdesc='PnP masa oyunları için 3D baskı, kart ve mukavva üretim takibi'
arch=('@ARCH@')
# The application's own code is MIT (Faz 3 / İş 15); the license text is
# installed below, and the embedded runtime and the libraries keep their own
# licenses, listed in THIRD_PARTY_NOTICES.md.
license=('MIT')
# What the application's own native code loads every time it starts: Skia
# (libGL, libX11, fontconfig, libstdc++) and AWT's X11 toolkit. The Java runtime
# is inside the package.
#
# The second line is the runtime's own: which of these it needs depends on the
# JDK the package was built with. Temurin bundles freetype, libpng, harfbuzz,
# libjpeg, lcms and giflib inside the image and needs none of them; Arch's
# jdk21-openjdk links the system ones instead. The package is built in both
# places — on a developer's machine and in the release container — so it
# declares what either build can need. freetype2, libpng and zlib already
# arrive with fontconfig; these four do not.
#
# alsa-lib is here because the runtime ships lib/runtime/lib/libjsound.so and
# that file links libasound, whatever the application does with it. It was left
# out before on the grounds that this application never plays a sound, which is
# true and beside the point: `depends` is about what the files in the package
# link, not about which of them get loaded.
depends=('glibc' 'libstdc++' 'libglvnd' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst' 'fontconfig'
         'harfbuzz' 'libjpeg-turbo' 'lcms2' 'giflib' 'alsa-lib')
# The embedded Java runtime and Skia must not be stripped or split.
options=('!strip' '!debug')
source=("@ARCHIVE@" 'pnp-tracker.desktop')
sha256sums=('@ARCHIVE_SHA256@' '@DESKTOP_SHA256@')

package() {
  install -d "$pkgdir/opt"
  cp -a "$srcdir/pnp-tracker-$pkgver" "$pkgdir/opt/pnp-tracker"
  install -d "$pkgdir/usr/bin"
  ln -s ../../opt/pnp-tracker/bin/pnp-tracker "$pkgdir/usr/bin/pnp-tracker"
  install -Dm644 "$srcdir/pnp-tracker.desktop" "$pkgdir/usr/share/applications/pnp-tracker.desktop"
  install -Dm644 "$srcdir/pnp-tracker-$pkgver/lib/pnp-tracker.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/pnp-tracker.png"
  install -Dm644 "$srcdir/pnp-tracker-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pnp-tracker-$pkgver/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
